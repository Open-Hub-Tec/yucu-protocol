# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# PRIVACIDAD (ADR-006, D1): en el nivel gratuito de AI Studio, Google puede usar lo que mandes y revisores
# humanos pueden leerlo. Úsalo solo con datos inventados. Con audios o datos de personas reales, usa Vertex AI
# o la API de pago.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STELLAR_CERTIFIER_SECRET: Llave del nodo certificador (rol certifier de lot_passport; identidad yucu-certifier).
# Es de la plataforma, NO de un productor. Solo la usa server.ts para co-firmar register_lot (ADR-003, D6).
# Nunca la pongas en el código, en el cliente ni en logs.
STELLAR_CERTIFIER_SECRET=""

# STELLAR_SPONSOR_SECRET: Llave de la cuenta patrocinadora (#94). Es de la plataforma, NO de una persona.
# Solo paga comisiones (fee-bump) y reservas de cuentas nuevas; nunca firma por la artesana (ADR-003).
# En Vercel: solo Production, marcada como Sensitive. Nunca la pongas en el código, en el cliente ni en logs.
STELLAR_SPONSOR_SECRET=""

# Topes del patrocinio (#94). Si se dejan vacíos se usan los valores por defecto (entre paréntesis).
# SPONSOR_MAX_FEE: comisión máxima por transacción, en stroops (1000000 = 0.1 XLM).
SPONSOR_MAX_FEE=""
# SPONSOR_MAX_TX_PER_DAY: transacciones patrocinadas por cuenta y por día (10).
SPONSOR_MAX_TX_PER_DAY=""
# SPONSOR_MAX_ACCOUNTS_PER_DAY: altas de cuenta con reserva patrocinada por día, en total (20).
SPONSOR_MAX_ACCOUNTS_PER_DAY=""
# SPONSOR_MAX_FEE_PER_DAY: gasto máximo de la cuenta patrocinadora por día, en stroops (50000000 = 5 XLM).
SPONSOR_MAX_FEE_PER_DAY=""

# SPONSOR_USDC_ISSUER: emisor (G…) del USDC de testnet. Sin él no se patrocinan trustlines ni altas.
SPONSOR_USDC_ISSUER=""

# SPONSOR_PROMOTERS: solo mientras se usa el almacén en memoria (#156). Direcciones G… de promotoras
# dadas de alta, separadas por comas. Son direcciones públicas, nunca llaves.
SPONSOR_PROMOTERS=""
